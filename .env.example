# defect-inspector example configuration. Copy to .env and edit.
# Placeholder values only. Never commit real keys.

# Choose a backend: "api" (bring your own key) or "hf" (open-source on Hugging Face)
MS_BACKEND=api

# --- (a) Bring your own API key: any OpenAI-compatible endpoint ---
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=your-api-key
VISION_MODEL=your-vision-model

# --- (b) Open-source models from Hugging Face ---
HF_MODE=local                  # local | inference
HF_TOKEN=your-hf-token         # only needed for gated models or HF Inference
HF_BACKBONE=timm/wide_resnet50_2.tv_in1k
HF_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
