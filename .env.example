# defect-inspector configuration. Copy to .env and edit.
# Placeholder values only. Never commit real keys.

# --- anomaly detection (always runs locally) ---
# PatchCore feature backbone: a timm model id, or a DINOv2 id such as facebook/dinov2-base (needs the hf extra)
MS_BACKBONE=timm/wide_resnet50_2.tv_in1k
# Images are resized to this square size before feature extraction
MS_IMAGE_SIZE=256
# Share of patch features kept in the memory bank (greedy coreset)
MS_CORESET_RATIO=0.1

# --- defect description (only for --describe and the "Describe regions" button) ---
# Choose a backend: "api" (bring your own key) or "hf" (open-source on Hugging Face)
MS_BACKEND=hf

# (a) api: any OpenAI-compatible endpoint with a vision-capable model
MS_API_BASE=https://your-provider.example/v1
MS_API_KEY=your-api-key
MS_MODEL=your-vision-model

# (b) hf: open vision-language models from Hugging Face, run locally with transformers
# Qwen2.5-VL-7B-Instruct needs a GPU. On a CPU-only machine use the 2B model in bfloat16 (about 5 GB of RAM).
MS_HF_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# MS_HF_VLM_MODEL=Qwen/Qwen3-VL-2B-Instruct
# MS_HF_DTYPE=bfloat16
MS_HF_DTYPE=auto
# HF_TOKEN=your-hf-token   # only needed for gated models

# --- shared ---
# Where the web demo keeps fitted sample models and saved descriptions
MS_CACHE_DIR=.cache
